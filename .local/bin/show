#!/usr/bin/env bash
set -e
set -u
set -o pipefail

edit_file=0

show_usage() {
   echo "usage: ${0##*/} [-e]" >&2
   exit 2;
}

while getopts ':e' opt; do
  case $opt in
    e) edit_file=1 ;;
    *) show_usage ;;
  esac
done
shift $((OPTIND - 1))

if (( $# < 1 )); then
   show_usage
fi

filepath="$(command -v -- "$1" || true)"
if [[ -z $filepath || ! -f $filepath ]]; then
  echo "${0##*/}: '$1' not found (or not a file)" >&2
  exit 1
fi

if (( edit_file )); then
   $EDITOR "$filepath"
elif command -v bat >/dev/null 2>&1; then
   bat "$filepath"
else
   batcat "$filepath"
fi
