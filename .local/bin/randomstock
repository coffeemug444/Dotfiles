#!/usr/bin/env python3

import json
import re
import random
import subprocess

result = subprocess.run(
    ["curl", "-s", "-A", ".", "https://www.slickcharts.com/sp500"],
    capture_output=True, text=True
)

match = re.search(r'sp500List:(\[.*?\])', result.stdout, re.DOTALL)
if not match:
    raise ValueError("sp500List not found")

js = match.group(1)
js = re.sub(r'(\w+):', r'"\1":', js)
js = re.sub(r':(-?)\.', r':\g<1>0.', js)

sp500 = json.loads(js)

blacklist = [
    "TSLA",
    "SPCX",
]

excluded = {s for s in already_bought} | {s for s in blacklist}
candidates = [item for item in sp500 if item["symbol"] not in excluded]

weights = [item["weight"] for item in candidates]
chosen = random.choices(candidates, weights=weights, k=1)[0]
print(f'{chosen["rank"]}. {chosen["symbol"]} - {chosen["name"]}')
