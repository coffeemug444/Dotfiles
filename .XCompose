include "%L"

# little letters, "^a"
<Multi_key> <asciicircum> <a> : "ᵃ"
<Multi_key> <asciicircum> <b> : "ᵇ"
<Multi_key> <asciicircum> <c> : "ᶜ"
<Multi_key> <asciicircum> <d> : "ᵈ"
<Multi_key> <asciicircum> <e> : "ᵉ"
<Multi_key> <asciicircum> <f> : "ᶠ"
<Multi_key> <asciicircum> <g> : "ᵍ"
<Multi_key> <asciicircum> <h> : "ʰ"
<Multi_key> <asciicircum> <i> : "ᶦ"
<Multi_key> <asciicircum> <j> : "ʲ"
<Multi_key> <asciicircum> <k> : "ᵏ"
<Multi_key> <asciicircum> <l> : "ˡ"
<Multi_key> <asciicircum> <m> : "ᵐ"
<Multi_key> <asciicircum> <n> : "ⁿ"
<Multi_key> <asciicircum> <o> : "ᵒ"
<Multi_key> <asciicircum> <p> : "ᵖ"
<Multi_key> <asciicircum> <q> : "ᑫ"
<Multi_key> <asciicircum> <r> : "ʳ"
<Multi_key> <asciicircum> <s> : "ˢ"
<Multi_key> <asciicircum> <t> : "ᵗ"
<Multi_key> <asciicircum> <u> : "ᵘ"
<Multi_key> <asciicircum> <v> : "ᵛ"
<Multi_key> <asciicircum> <w> : "ʷ"
<Multi_key> <asciicircum> <x> : "ˣ"
<Multi_key> <asciicircum> <y> : "ʸ"
<Multi_key> <asciicircum> <z> : "ᶻ"

# logic symbols
<Multi_key> <o> <r>           : "∨"
<Multi_key> <a> <n> <d>       : "∧"
<Multi_key> <n> <o> <t>       : "¬"
<Multi_key> <x> <o> <r>       : "⊕ "
<Multi_key> <i> <f> <f>       : "↔"
<Multi_key> <a> <l> <l>       : "∀"
<Multi_key> <e> <x> <i> <s> <t>  : "∃"
<Multi_key> <m> <e> <m>          : "∈"
<Multi_key> <exclam> <m> <e> <m> : "∉"

# Set relations
<Multi_key> <s> <u> <b> <s>            : "⊂"
<Multi_key> <s> <u> <b> <e>            : "⊆"
<Multi_key> <exclam> <s> <u> <b> <s>   : "⊄"
<Multi_key> <exclam> <s> <u> <b> <e>   : "⊈"
<Multi_key> <s> <u> <p> <s>            : "⊃"
<Multi_key> <s> <u> <p> <e>            : "⊇"
<Multi_key> <exclam> <s> <u> <p> <s>   : "⊅"
<Multi_key> <exclam> <s> <u> <p> <e>   : "⊉"
<Multi_key> <c> <o> <n> <t> <s>        : "∋"
<Multi_key> <exclam> <c> <o> <n> <t>   : "∌"

# Set operations
<Multi_key> <u> <n> <i>                : "∪"
<Multi_key> <i> <n> <t>                : "∩"
<Multi_key> <s> <m> <i>                : "∖"
<Multi_key> <s> <y> <m> <d>            : "∆"

# Special sets
<Multi_key> <e> <m> <p> <t>            : "∅"
<Multi_key> <p> <o> <w> <e>            : "𝒫"

# Big operators
<Multi_key> <b> <u> <n> <i>            : "⋃"
<Multi_key> <b> <i> <n> <t>            : "⋂"
